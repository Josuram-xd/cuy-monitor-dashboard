:80 {
	root * /srv
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# hashed file names: safe to cache for a year
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# everything else ends up as index.html (/, /alerts...): check for a new one after a deploy.
	# header runs before try_files, so match by "not an asset" instead of /index.html
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	# SPA: unknown paths fall back to index.html and React Router takes over
	try_files {path} /index.html
	file_server
}
