# Public: VITE_* variables end up in the browser bundle. Never put secrets here.

# Empty = same origin (production, and dev through the Vite proxy).
VITE_API_URL=
# Empty = wss://<current host>/ws
VITE_WS_URL=
# Single pilot cage (the cage code).
VITE_CAGE_ID=cage-1
# Public OAuth client id for "Continuar con Google" (Google Cloud Console > Credentials > Web client).
# Empty hides the button. It is not a secret. With VITE_USE_MOCKS=true a demo button is shown instead.
VITE_GOOGLE_CLIENT_ID=
# true = serve fake data and a fake login (any user, code 123456) from src/mocks.
VITE_USE_MOCKS=true
# Only used by the Vite dev proxy for /api and /ws.
VITE_DEV_BACKEND=http://localhost:8080
